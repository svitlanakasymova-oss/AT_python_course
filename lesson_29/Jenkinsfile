pipeline {
    agent any

    stages {
        stage('Checkout code') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                sh '''
                    cd lesson_29
                    python3 -m venv venv
                    . venv/bin/activate
                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    cd lesson_29
                    . venv/bin/activate
                    mkdir -p reports
                    pytest test_trivial.py --junitxml=reports/test-results.xml
                '''
            }
        }

        stage('Publish test results') {
            steps {
                junit 'lesson_29/reports/test-results.xml'
            }
        }
    }
}